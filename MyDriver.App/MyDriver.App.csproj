<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms hanya untuk ikon tray (NotifyIcon); namespace-nya tidak diimpor global agar tidak bentrok dengan WPF -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MyDriver</AssemblyName>
    <RootNamespace>MyDriver.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MyDriver.ico</ApplicationIcon>
    <Title>My Driver!</Title>
  </PropertyGroup>

  <!-- Publish: satu file exe self-contained (dotnet publish MyDriver.App -c Release -o publish) -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Tanpa kompresi: exe ~125 MB (bukan ~59 MB), tetapi RAM turun dari ~210 MB ke ~110 MB
         dan isi exe dibaca seperlunya (lebih cepat dari flashdisk), tidak diurai seluruhnya saat mulai. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ikon dan gambar dibuat oleh tools\make-icon.ps1 -->
    <Resource Include="Assets\MyDriver.ico" />
    <Resource Include="Assets\logo-64.png" />
    <!-- Layar pembuka ditampilkan dari kode (tidak saat scan latar) -->
    <Resource Include="Assets\splash.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Proyek WPF tidak mengimpor System.IO secara otomatis -->
    <Using Include="System.IO" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyDriver.Core\MyDriver.Core.csproj" />
    <ProjectReference Include="..\MyDriver.Windows\MyDriver.Windows.csproj" />
  </ItemGroup>

</Project>
