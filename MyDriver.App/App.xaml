<Application x:Class="MyDriver.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MyDriver.App.ViewModels"
             xmlns:views="clr-namespace:MyDriver.App.Views"
             xmlns:local="clr-namespace:MyDriver.App"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Indeks 0 = warna tema; diganti ThemeService saat tema berubah -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:NullToCollapsedConverter x:Key="NullToCollapsed" />

            <!-- Setiap ViewModel halaman ditampilkan oleh View pasangannya -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
            <!-- Sementara memakai tampilan "segera hadir"; diganti View sendiri di tahapnya -->
            <DataTemplate DataType="{x:Type vm:ProblemsViewModel}"><views:PlaceholderPageView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DevicesViewModel}"><views:DevicesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BackupViewModel}"><views:BackupView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:PlaceholderPageView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
