<UserControl x:Class="MyDriver.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MyDriver.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="36,30">
        <TextBlock Style="{StaticResource PageTitleText}" Text="Beranda" />
        <TextBlock Style="{StaticResource PageSubtitleText}" Text="Ringkasan kesehatan driver di komputer ini." />

        <!-- Alur pertama kali di komputer baru -->
        <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
                Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IconText}" FontSize="26" VerticalAlignment="Top" Margin="0,2,18,0"
                           Foreground="{DynamicResource AccentBrush}" Text="&#xE7F8;" />

                <!-- Langkah 1: apakah semua normal? -->
                <StackPanel Grid.Column="1" Visibility="{Binding IsAskHealthy, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SectionTitleText}" Margin="0,0,0,4">
                        <Run Text="Komputer baru terdeteksi:" />
                        <Run Text="{Binding ComputerName, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="Apakah semua perangkat saat ini berfungsi normal (WiFi, suara, layar, kamera, Bluetooth)? Jika ya, kondisi ini disimpan sebagai acuan sehat untuk perbandingan dan pemulihan nanti." />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0" Foreground="{DynamicResource StatusWarningBrush}"
                               Text="{Binding ProblemNote}" Visibility="{Binding ProblemNote, Converter={StaticResource NullToCollapsed}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Padding="16,7" Style="{DynamicResource AccentButtonStyle}" Content="Ya, semuanya normal"
                                Command="{Binding AnswerHealthyCommand}" />
                        <Button Padding="16,7" Margin="8,0,0,0" Content="Belum / tidak yakin"
                                Command="{Binding AnswerNotHealthyCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- Langkah 2: tawaran backup -->
                <StackPanel Grid.Column="1" Visibility="{Binding IsOfferBackup, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SectionTitleText}" Margin="0,0,0,4" Text="Backup driver sekarang? (disarankan)" />
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding OfferBackupIntro}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="Backup menyimpan salinan driver komputer ini, sehingga driver bisa dipasang ulang tanpa internet bila nanti bermasalah. Prosesnya beberapa menit." />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0" Foreground="{DynamicResource StatusWarningBrush}"
                               Text="Backup butuh hak Administrator. Anda bisa melakukannya nanti dari halaman Backup."
                               Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Padding="16,7" Style="{DynamicResource AccentButtonStyle}" Content="Backup sekarang"
                                Command="{Binding BackupFromOnboardingCommand}" IsEnabled="{Binding CanBackup}" />
                        <Button Padding="16,7" Margin="8,0,0,0" Content="Nanti saja"
                                Command="{Binding SkipBackupCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status besar: hijau / kuning / merah. Abu-abu = belum dipindai. -->
        <Border Style="{StaticResource Card}" Padding="28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="72" Height="72" CornerRadius="36" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource StatusUnknownBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:HomeStatus.Safe}">
                                    <Setter Property="Background" Value="{DynamicResource StatusSafeBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:HomeStatus.Attention}">
                                    <Setter Property="Background" Value="{DynamicResource StatusWarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:HomeStatus.Problem}">
                                    <Setter Property="Background" Value="{DynamicResource StatusCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="32" Foreground="White" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                <Setter Property="Text" Value="&#xE9CE;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:HomeStatus.Safe}">
                                        <Setter Property="Text" Value="&#xE73E;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:HomeStatus.Attention}">
                                        <Setter Property="Text" Value="&#xE7BA;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:HomeStatus.Problem}">
                                        <Setter Property="Text" Value="&#xE711;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                    <TextBlock FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding StatusTitle}" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding StatusDescription}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <Button Padding="20,10" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                        Style="{DynamicResource AccentButtonStyle}" Content="Lihat masalah"
                        Command="{Binding OpenProblemsCommand}"
                        Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}" />
                <Button Padding="20,10" HorizontalAlignment="Stretch" Command="{Binding ScanCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE721;" Margin="0,0,8,0" />
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Scan sekarang" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="Text" Value="Memindai…" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Columns="3">
            <Border Style="{StaticResource Card}" Margin="0,0,6,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="Jumlah temuan" />
                    <TextBlock Style="{StaticResource SectionTitleText}" Margin="0,6,0,0" Text="{Binding FindingCountText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,6,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="Scan terakhir" />
                    <TextBlock Style="{StaticResource SectionTitleText}" Margin="0,6,0,0" Text="{Binding LastScanText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="Backup terakhir" />
                    <TextBlock Style="{StaticResource SectionTitleText}" Margin="0,6,0,0" Text="{Binding LastBackupText}" />
                </StackPanel>
            </Border>
        </UniformGrid>
    </StackPanel>
    </ScrollViewer>
</UserControl>
