<UserControl x:Class="MyDriver.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MyDriver.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="36,30">
            <Grid>
                <StackPanel Margin="0,0,220,0">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="Riwayat" />
                    <TextBlock Style="{StaticResource PageSubtitleText}" Margin="0,0,0,16" Text="{Binding SummaryText}" />
                </StackPanel>
                <ComboBox HorizontalAlignment="Right" VerticalAlignment="Top" Width="210" Margin="0,6,0,0"
                          ItemsSource="{Binding Filters}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedFilter}"
                          AutomationProperties.Name="Saring riwayat" />
            </Grid>

            <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource BodyText}"
                           Text="Belum ada catatan di sini. Setiap aksi perbaikan, backup, dan pemulihan akan tercatat beserta hasil dan restore point-nya." />
            </Border>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryItemViewModel}">
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontSize="18" Margin="0,2,14,0" VerticalAlignment="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                            <Setter Property="Foreground" Value="{DynamicResource StatusSafeBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="fail">
                                                    <Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="scan">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding TimeText}" />
                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" Text="{Binding Message}"
                                               Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" Text="{Binding RestorePointText}"
                                               Visibility="{Binding RestorePointText, Converter={StaticResource NullToCollapsed}}" />
                                    <Expander Header="Perintah yang dijalankan" Margin="0,6,0,0"
                                              Visibility="{Binding HasCommands, Converter={StaticResource BoolToVisibility}}">
                                        <TextBox IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0"
                                                 Text="{Binding CommandsText, Mode=OneWay}" />
                                    </Expander>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="12,2,0,0"
                                           VerticalAlignment="Top" Text="{Binding StatusText}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
