<UserControl x:Class="MyDriver.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MyDriver.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="36,30">
        <TextBlock Style="{StaticResource PageTitleText}" Text="Pengaturan" />
        <TextBlock Style="{StaticResource PageSubtitleText}" Text="Pemantauan otomatis, tampilan, folder data, dan informasi aplikasi." />

        <!-- Pemantauan otomatis (Task Scheduler) -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Pemantauan otomatis" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding MonitoringText}" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" Foreground="{DynamicResource StatusWarningBrush}"
                                   Text="My Driver! sedang dijalankan dari flashdisk; scan otomatis tidak jalan saat flashdisk dicabut."
                                   Visibility="{Binding IsOnRemovableDrive, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource StatusWarningBrush}"
                                   Text="Mengubah pemantauan butuh hak Administrator; saat tombol ditekan, Anda ditawari membuka ulang aplikasi sebagai Administrator.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Environment.IsAdministrator}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" MinWidth="110" Padding="14,6" VerticalAlignment="Center"
                            Command="{Binding ToggleMonitoringCommand}" IsEnabled="{Binding CanChangeMonitoring}" AutomationProperties.Name="Aktifkan atau matikan pemantauan otomatis">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="Aktifkan" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoringEnabled}" Value="True">
                                        <Setter Property="Content" Value="Matikan" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Separator Margin="0,14" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyText}" Text="Jam scan harian" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="Bila komputer mati pada jam itu, scan dijalankan saat komputer menyala lagi." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" MinWidth="110" VerticalAlignment="Center"
                              ItemsSource="{Binding HourOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedHour}"
                              AutomationProperties.Name="Jam scan harian" />
                </Grid>

                <CheckBox Margin="0,14,0,0" IsChecked="{Binding NotificationsEnabled}"
                          Content="Tampilkan notifikasi bila scan otomatis menemukan masalah baru" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Tema" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="Pilih tampilan terang, gelap, atau ikuti pengaturan Windows." />
                </StackPanel>
                <ComboBox Grid.Column="1" MinWidth="180" VerticalAlignment="Center"
                          ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedTheme}"
                          AutomationProperties.Name="Tema" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Folder data" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,10"
                           Text="Snapshot, backup, riwayat, dan log disimpan di sini, dipisah per komputer." />
                <TextBox IsReadOnly="True" Text="{Binding DataFolder, Mode=OneWay}" Margin="0,0,0,10"
                         AutomationProperties.Name="Lokasi folder data" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Buka folder data" Command="{Binding OpenDataFolderCommand}" Padding="14,6" Margin="0,0,8,0" />
                    <Button Content="Buka folder log" Command="{Binding OpenLogFolderCommand}" Padding="14,6" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Hak akses" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0" Text="{Binding ModeText}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Tampilan perangkat" />
                <CheckBox Margin="0,8,0,0" IsChecked="{Binding HideDisconnectedDevices}"
                          Content="Sembunyikan perangkat yang sedang tidak tersambung" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="26,2,0,0"
                           Text="Berlaku untuk halaman Perangkat saat aplikasi dibuka berikutnya." />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource CaptionText}" Margin="2,4,0,0">
            <Run Text="My Driver! versi" /> <Run Text="{Binding AppVersion, Mode=OneWay}" />
        </TextBlock>
    </StackPanel>
    </ScrollViewer>
</UserControl>
